# Official Gemini API Key (Google AI Studio)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Cost-Controlled Model Routing (85% Fast Flash / 15% Deep Pro)
FAST_TUTOR_MODEL="gemini-3.5-flash-lite"
DEEP_TUTOR_MODEL="gemini-3.1-flash-lite"
FALLBACK_TUTOR_MODEL="gemini-3.1-flash-lite"
EMBEDDING_MODEL="gemini-embedding-001"

# Supabase Persistence, Caching & Full-Document RAG (pgvector)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_SERVICE_ROLE_OR_ANON_KEY"

# In-Memory PDF Rendering Guardrails (PyMuPDF)
PDF_RENDER_DPI=150
MAX_PDF_SIZE_MB=25
MAX_RENDER_DIM_PX=1600

# CORS Allowed Origins (comma-separated). Use "*" only during local development.
CORS_ORIGINS="*"
